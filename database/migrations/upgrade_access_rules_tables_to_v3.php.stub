            $table->unique(['type', 'original_id'], 'acr_owner_unique');
        });

        Schema::table($tables->inheritance, function (Blueprint $table) use ($tables) {
            $table->unique(['owner_id', 'owner_parent_id'], 'acr_inheritance_unique');
            $table->index('owner_parent_id', 'acr_inheritance_parent');

            // SQLite cannot add a foreign key to an existing table. The package removes links
            // of an owner by itself, the key only guards against changes made straight in the database.
