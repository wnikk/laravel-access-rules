<?php

use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Schema;
use Illuminate\Database\Schema\Blueprint;
use Illuminate\Database\Migrations\Migration;

/**
 * Upgrade of tables created by version 2.x. New columns are added, existing rows stay valid.
 *
 * One thing of version 2 goes away: rules were soft deleted, version 3 deletes them for good.
 * Rows that version 2 had soft deleted would come back to life when the column disappears,
 * permissions included. They are renamed to "deprecated__<name>" instead: no code asks for
 * such a name, so they stay as inert as they were, nothing is lost, and the original name is
 * free again. Remove them from an admin panel or with "php artisan acr:delete" when convenient.
 *
 * Tables of version 2 also had no unique indexes, so an owner, a link or a permission could be
 * stored twice. Version 3 creates tables with these indexes, and the upgrade adds them. Nothing
 * is deleted to make room: which of two rows is the right one is a question about the project.
 * When duplicates exist the migration lists them and stops before it has changed anything.
 */
return new class extends Migration
{
    protected function tables(): stdClass
    {
        $tables = config('access.table_names');

        if (empty($tables)) {
            throw new \Exception('Error: config/access.php not loaded. Run [php artisan config:clear] and try again.');
        }

        return (object)$tables;
    }

    public function up()
    {
        $tables      = $this->tables();
        $constrained = Schema::hasIndex($tables->owner, 'acr_owner_unique');

        // First, and before any change: MySQL commits every ALTER TABLE at once, so a stop
        // in the middle would leave tables half upgraded and the migration not repeatable.
        if (! $constrained) {
            $this->failOnDuplicates($tables->owner, ['type', 'original_id']);
            $this->failOnDuplicates($tables->inheritance, ['owner_id', 'owner_parent_id']);
            $this->failOnDuplicates($tables->permission, ['owner_id', 'rule_id', 'option', 'permission']);
        }

        Schema::table($tables->rule, function (Blueprint $table) use ($tables) {
            if (!Schema::hasColumn($tables->rule, 'resource')) {
                $table->string('resource', 64)->nullable()->after('options');
            }
            if (!Schema::hasColumn($tables->rule, 'condition')) {
                $table->jsonb('condition')->nullable()->after('options');
            }
            if (!Schema::hasColumn($tables->rule, 'origin')) {
                // Every existing rule counts as coming with code: whether it was typed into the admin panel
                // of version 2 cannot be told, and "cannot be deleted by a click" is the safe mistake.
                $table->string('origin', 16)->default('code')->after('description');
            }
        });

        if (Schema::hasColumn($tables->rule, 'deleted_at')) {
            $deprecated = DB::table($tables->rule)->whereNotNull('deleted_at')->get(['id', 'parent_id', 'guard_name']);

            foreach ($deprecated as $rule) {
                // Children move one level up, as they do when a rule is deleted. With config
                // access.rule_tree_inheritance a permission for the dead parent would otherwise cover them.
                DB::table($tables->rule)->where('parent_id', $rule->id)->update(['parent_id' => $rule->parent_id]);

                // "custom", so an administrator can remove the leftovers without a migration.
                DB::table($tables->rule)->where('id', $rule->id)->update(['guard_name' => 'deprecated__'.$rule->guard_name, 'origin' => 'custom']);
            }

