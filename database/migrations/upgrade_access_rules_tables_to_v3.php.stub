                $table->foreign('owner_parent_id', 'acr_inheritance_parent_fk')
                    ->references('id')
                    ->on($tables->owner)
                    ->onDelete('cascade');
            }
        });

        Schema::table($tables->permission, function (Blueprint $table) {
            $table->unique(['owner_id', 'rule_id', 'option', 'permission'], 'acr_permission_unique');
        });
    }

    protected function failOnDuplicates(string $table, array $columns): void
    {
        $duplicates = DB::table($table)
            ->select($columns)
            ->selectRaw('count(*) as duplicates')
            ->groupBy($columns)
            ->havingRaw('count(*) > 1')
            ->limit(20)
            ->get();

        if ($duplicates->isNotEmpty()) {
            throw new \Exception(
                'Table "'.$table.'" has duplicates by ('.implode(', ', $columns).'), remove them and run the migration again: '
                .$duplicates->toJson()
            );
        }
    }

    public function down()
    {
        $tables = $this->tables();

        if (Schema::hasIndex($tables->owner, 'acr_owner_unique')) {
            // MySQL keeps an index under every foreign key. It gave up its own index on owner_id when the unique
            // ones, which start with that column, appeared, and it refuses to drop them until it gets one back.
            $mysql = in_array(DB::getDriverName(), ['mysql', 'mariadb'], true);

            Schema::table($tables->permission, function (Blueprint $table) use ($tables, $mysql) {
                if ($mysql) {
                    $table->index('owner_id', $tables->permission.'_owner_id_foreign');
                }
                $table->dropUnique('acr_permission_unique');
            });

            Schema::table($tables->inheritance, function (Blueprint $table) use ($tables, $mysql) {
                if (DB::getDriverName() !== 'sqlite') {
                    $table->dropForeign('acr_inheritance_parent_fk');
                }
                if ($mysql) {
                    $table->index('owner_id', $tables->inheritance.'_owner_id_foreign');
                }
                $table->dropIndex('acr_inheritance_parent');
                $table->dropUnique('acr_inheritance_unique');
            });

            Schema::table($tables->owner, function (Blueprint $table) {
                $table->dropUnique('acr_owner_unique');
            });
        }

        // Back to version 2: renamed rules become soft deleted ones again. Their place in the tree is not restored.
        Schema::table($tables->rule, function (Blueprint $table) {
            $table->softDeletes();
        });

        // Filtered in PHP: "_" is a wildcard of LIKE, and escaping it is spelled differently on every server.
        foreach (DB::table($tables->rule)->where('guard_name', 'like', 'deprecated%')->get(['id', 'guard_name']) as $rule) {
            if (! str_starts_with($rule->guard_name, 'deprecated__')) {
                continue;
            }
            DB::table($tables->rule)->where('id', $rule->id)->update(['guard_name' => substr($rule->guard_name, strlen('deprecated__')), 'deleted_at' => now()]);
        }

        Schema::table($tables->rule, function (Blueprint $table) {
            $table->dropColumn(['resource', 'condition', 'origin']);
        });

        Schema::table($tables->permission, function (Blueprint $table) {
            $table->dropColumn('condition');
        });
    }
};
