<?xml version="1.0" encoding="UTF-8"?>
<phpunit backupGlobals="false"
         bootstrap="vendor/autoload.php"
         colors="true"
         processIsolation="false"
         stopOnFailure="false"
         defaultTestSuite="Unit Test Suite,Feature"
>
    <testsuites>
        <!-- The suite inherited from version 2: proof that its API still works. -->
        <testsuite name="Unit Test Suite">
            <directory suffix=".php">tests/Unit</directory>
        </testsuite>
        <!-- What the documentation promises, tested from outside. See tests/Feature/FeatureTestCase.php. -->
        <testsuite name="Feature">
            <directory suffix="Test.php">tests/Feature</directory>
        </testsuite>
        <testsuite name="Bench">
            <directory suffix=".php">tests/Bench</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="CACHE_DRIVER" value="array"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="QUEUE_DRIVER" value="sync"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
    </php>
</phpunit>
